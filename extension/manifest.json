{
  "manifest_version": 3,
  "name": "LyricFloat Bridge",
  "version": "0.2.0",
  "description": "Streams Apple Music playback state and lyrics to the LyricFloat desktop overlay.",
  "minimum_chrome_version": "111",
  "host_permissions": [
    "https://music.apple.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["content-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
